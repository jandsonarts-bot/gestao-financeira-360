rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /dividas/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.criador == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.criador == request.auth.uid;
    }
    match /pagamentos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.quem == request.auth.uid;
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
